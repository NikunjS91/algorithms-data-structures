   "source": [
    "def removeAllOcc(s,word):\n",
    "    while word in s:\n",
    "        idx=s.find(word)\n",
    "        s = s[:idx] + s[idx + len(word):]\n",
    "    return s\n",
    "\n",
    "s=\"daabcbaabcbc\"\n",
    "word=\"abc\"\n",
    "result = removeAllOcc(s,word)\n",
    "print(result)"
   ]
  }
